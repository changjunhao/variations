# variations-serve-go 本地开发环境变量（make dev 自动加载；生产由 systemd EnvironmentFile 注入）

# ===== 模型供应商：qwen（阿里百炼）| ark（火山方舟 doubao 系列） =====
# MODEL_PROVIDER 为编译+生图统一默认；COMPILE_PROVIDER / IMAGE_PROVIDER 可按管线细分覆盖
# （优先级：COMPILE_PROVIDER/IMAGE_PROVIDER > MODEL_PROVIDER > qwen）；
# 单个 skill 还可在 assets/pipeline-overrides.json 再覆盖；
# 任一管线用到某供应商，其 API Key 即必填（混搭引用到的供应商缺 key 启动时告警）
#MODEL_PROVIDER=qwen
#COMPILE_PROVIDER=qwen
#IMAGE_PROVIDER=qwen

# ===== 阿里百炼（qwen VL 编译 + qwen-image 生图；编译或生图管线用到 qwen 时必填） =====
DASHSCOPE_API_KEY=
# 百炼端点根（可选）：默认 https://dashscope.aliyuncs.com
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ===== 火山方舟（doubao VL 编译 + seedream 生图；编译或生图管线用到 ark 时必填） =====
ARK_API_KEY=

# ===== 设备注册门槛（App Secret；未配置则注册端点 503，无法签发新 token） =====
REGISTER_SECRET=

# ===== SIWA 用户系统（iOS Bundle ID，identityToken aud 校验；未配置则登录端点 503） =====
#APPLE_CLIENT_ID=cn.ifable.Variations

# ===== 每日积分配额（可选，默认值如下） =====
# 游客终身体验次数；新用户特权天数与每日次数
#GUEST_FREE_TOTAL=1
#NEW_USER_PRIVILEGE_DAYS=7
#NEW_USER_DAILY=10
# 编译防刷每日上限（游客/用户）
#GUEST_DAILY_COMPILE_CAP=20
#USER_DAILY_COMPILE_CAP=100

# ===== IAP 积分包（productID:次数 逗号分隔；未配置则购买落账 503） =====
#IAP_PRODUCT_MAP=cn.ifable.Variations.pack.small:10,cn.ifable.Variations.pack.medium:60,cn.ifable.Variations.pack.large:160
# 票据环境校验：Production|Sandbox
#IAP_ENVIRONMENT=Production

# ===== Staff 白名单（开发者自用：Apple sub 逗号分隔，命中者生图不扣减；服务端日志 "user signed in userId=..." 可查自己的 sub） =====
#STAFF_USER_IDS=

# ===== 运维旁路 token（可选，smoke/调试用；生产建议不配置） =====
#ADMIN_TOKEN=

# ===== 阿里云 OSS（bucket 私有，预签名直传） =====
# region ID 规范写法（如 cn-beijing；oss- 前缀旧写法亦兼容）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== 样图公共读前缀（可选，如 https://<bucket>.<endpoint>/public） =====
OSS_PUBLIC_PREFIX=

# ===== 限频（可选） =====
# upload-ticket 每设备每分钟
#RATE_LIMIT_PER_MIN=60
# 设备注册每 IP 每分钟
#AUTH_REGISTER_PER_MIN=10
# SIWA 登录每 IP 每分钟
#AUTH_APPLE_PER_MIN=10

# ===== qwen 模型（可选，默认值如下；对应管线为 qwen 时生效） =====
# 编译走 Responses API：须为百炼 Responses API 兼容模型（qwen-vl 系列不兼容）
#QWEN_VL_MODEL=qwen3.7-plus
#QWEN_IMAGE_MODEL=qwen-image-3.0

# ===== 火山方舟模型（可选，默认值如下；对应管线为 ark 时生效） =====
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#ARK_VL_MODEL=doubao-seed-2-0-lite-260428
#ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# ===== 请求超时（ms，编译/生图长耗时场景） =====
#REQUEST_TIMEOUT_MS=300000

# ===== 日志（可选，默认值如下） =====
# 级别：debug|info|warn|error
#LOG_LEVEL=info
# 格式：text|json；json 输出结构化单行，适合 journald/日志服务采集
#LOG_FORMAT=text

# ===== 资产与数据（可选） =====
# skills 资产目录：默认探测 ./assets（随 Go 服务自包含）
#ASSETS_DIR=
# SQLite 数据库文件
#DB_PATH=./data/variations.db

# ===== 服务 =====
# 本地开发建议 8788；生产 8787
PORT=8788
# 默认 0.0.0.0 供真机/局域网联调；鉴权闸门由设备 token 承担
HOST=0.0.0.0
