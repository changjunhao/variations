# variations-serve-go 生产环境变量模板（systemd EnvironmentFile）
# 部署：cp variations.env.example /opt/variations-serve/variations.env && 填值 && chmod 600

# ===== 模型供应商（优先级：COMPILE/IMAGE_PROVIDER > MODEL_PROVIDER > qwen） =====
#MODEL_PROVIDER=qwen
#COMPILE_PROVIDER=qwen
#IMAGE_PROVIDER=qwen

# ===== 供应商密钥（对应管线用到即必填） =====
DASHSCOPE_API_KEY=
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ARK_API_KEY=
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 模型（可选，默认如下） =====
#QWEN_VL_MODEL=qwen3.7-plus
#QWEN_IMAGE_MODEL=qwen-image-3.0
#ARK_VL_MODEL=doubao-seed-2-0-lite-260428
#ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# ===== 设备注册门槛（必填：openssl rand -hex 32；与 iOS 端内置值一致） =====
REGISTER_SECRET=

# ===== SIWA 登录（必填：iOS Bundle ID，identityToken aud 校验；缺失则登录端点 503） =====
APPLE_CLIENT_ID=cn.ifable.Variations

# ===== SIWA 授权撤销（必填：App Store 5.1.1(v) 要求注销时撤销 Apple 授权） =====
# .p8 来自开发者门户 Keys 的「Sign in with Apple」Key，只能下载一次；
# 上传至 /opt/variations-serve/AuthKey_XXXXXXXXXX.p8 并 chmod 600（不入库）。
APPLE_TEAM_ID=QU7V9M9C3Z
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/opt/variations-serve/AuthKey_XXXXXXXXXX.p8

# ===== IAP 积分包（必填：productID:次数；缺失则购买落账 503） =====
IAP_PRODUCT_MAP=cn.ifable.Variations.pack.small:10,cn.ifable.Variations.pack.medium:60,cn.ifable.Variations.pack.large:160
# 票据环境白名单：必须包含 Sandbox，否则 TestFlight 内测与 App Review 审核员的购买会全部 401
# （只有 App Store 正式下载的用户才是 Production）
IAP_ENVIRONMENT=Production,Sandbox

# ===== 运维旁路（可选，生产建议留空） =====
#ADMIN_TOKEN=

# ===== 阿里云 OSS =====
# region ID 规范写法（如 cn-beijing；oss- 前缀旧写法亦兼容）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
#OSS_PUBLIC_PREFIX=

# ===== 限频（可选） =====
#RATE_LIMIT_PER_MIN=60
#AUTH_REGISTER_PER_MIN=10
#AUTH_APPLE_PER_MIN=10

# ===== 超时（可选） =====
#REQUEST_TIMEOUT_MS=300000

# ===== 日志 =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== 资产与数据（生产固定路径） =====
ASSETS_DIR=/opt/variations-serve/assets
DB_PATH=/opt/variations-serve/data/variations.db

# ===== 服务 =====
PORT=8787
HOST=0.0.0.0
